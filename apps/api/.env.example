APP_NAME=Stormwater V2 API
ENVIRONMENT=local

# Local Postgres example. Copy this file to .env and change credentials as needed.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stormwater_v2
CORS_ORIGINS=http://localhost:3000

# Optional Outlook Import Preview MVP settings. Leave blank to run CRM locally
# without Microsoft Graph. Do not commit real secrets in .env.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/outlook/oauth/callback
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
