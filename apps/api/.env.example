APP_NAME=Stormwater V2 API
ENVIRONMENT=local

# Local Postgres example. Copy this file to .env and change credentials as needed.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stormwater_v2
CORS_ORIGINS=http://localhost:3000

# Staging auth. Local demo defaults to AUTH_ENABLED=false. For protected
# staging set AUTH_ENABLED=true, provide a strong JWT_SECRET_KEY, and seed a
# demo/admin user with DEMO_ADMIN_EMAIL and DEMO_ADMIN_PASSWORD.
AUTH_ENABLED=false
JWT_SECRET_KEY=
JWT_EXPIRES_MINUTES=720
AUTH_COOKIE_NAME=stormwater_v2_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
DEMO_ADMIN_EMAIL=admin@stormwater.local
DEMO_ADMIN_PASSWORD=

# Optional Outlook OAuth + Import Preview/Draft settings. Leave blank to run CRM
# locally without Microsoft Graph. Draft creation requires Mail.ReadWrite but
# never requests Mail.Send. Do not commit real secrets in .env.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/outlook/auth/callback
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
TOKEN_ENCRYPTION_KEY=

# Optional AI assistant settings. Leave OPENAI_API_KEY blank to keep AI provider
# calls disabled; deterministic Work Hub extraction still works locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_FEATURES_ENABLED=

# Optional Google Drive Picker readiness settings. These are used only for
# configuration/status checks; the browser Picker UI also needs the matching
# NEXT_PUBLIC_* values in apps/web/.env.local. Restrict real keys in Google
# Cloud and never commit secrets in .env.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
