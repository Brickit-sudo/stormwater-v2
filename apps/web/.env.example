NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_ENABLED=false

# Temporary until auth and organization scoping are implemented.
# Used only when NEXT_PUBLIC_AUTH_ENABLED=false. Run apps/api/scripts/seed_dev.py,
# then paste the printed organization id here.
NEXT_PUBLIC_DEMO_ORG_ID=

# Optional browser-safe Google Drive Picker settings. Keep real keys restricted
# in Google Cloud. Leave blank to show the configure state instead of a picker.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
